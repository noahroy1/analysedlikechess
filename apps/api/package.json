{
  "name": "@als/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:start && node scripts/dev-setup.ts && wrangler dev --port 8790",
    "typecheck": "tsc --noEmit",
    "db:keys": "cd ../.. && (test -f supabase/signing_keys.json || (echo '[]' > supabase/signing_keys.json && supabase gen signing-key --algorithm ES256 --append))",
    "db:start": "pnpm db:keys && PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin\" supabase start --workdir ../.. > /dev/null && echo 'local Supabase is up'",
    "db:stop": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin\" supabase stop --workdir ../..",
    "db:reset": "PATH=\"$PATH:/Applications/Docker.app/Contents/Resources/bin\" supabase db reset --workdir ../..",
    "test:db": "node scripts/with-supabase.ts vitest run --root ../.. apps/api/src/db"
  },
  "dependencies": {
    "@als/composition": "workspace:*",
    "@als/schema": "workspace:*",
    "@als/theme": "workspace:*",
    "@anthropic-ai/sdk": "0.133.0",
    "@cloudflare/containers": "0.3.7",
    "@google/genai": "2.28.0",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@als/media": "workspace:*",
    "@cloudflare/workers-types": "5.20261104.1",
    "@hono/node-server": "2.1.4",
    "@types/pg": "8.23.1",
    "supabase": "3.0.0",
    "wrangler": "4.157.0"
  }
}
