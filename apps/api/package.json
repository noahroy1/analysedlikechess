{
  "name": "@als/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:keys": "cd ../.. && (test -f supabase/signing_keys.json || (echo '[]' > supabase/signing_keys.json && supabase gen signing-key --algorithm ES256 --append))",
    "db:start": "pnpm db:keys && supabase start --workdir ../..",
    "db:stop": "supabase stop --workdir ../..",
    "db:reset": "supabase db reset --workdir ../..",
    "test:db": "node scripts/with-supabase.ts vitest run --root ../.. apps/api/src/db"
  },
  "dependencies": {
    "@als/schema": "workspace:*",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@types/pg": "8.23.1",
    "supabase": "3.0.0",
    "wrangler": "4.157.0"
  }
}
