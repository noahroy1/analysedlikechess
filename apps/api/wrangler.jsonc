// The API Worker (PLAN-CLOUD.md, Architecture). Local dev: `wrangler dev` with
// local Supabase (`pnpm db:start`); secrets for dev go in `.dev.vars` (gitignored).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "als-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "als-media" }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Created in C4 (staging and production). Locally Wrangler connects straight to local Supabase.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ],
  // One Workflow instance per job (ingest, analysis, render), named by the job's id.
  "workflows": [{ "name": "als-jobs", "binding": "JOBS", "class_name": "JobWorkflow" }],
  "vars": {
    "SUPABASE_URL": "http://127.0.0.1:54321",
    // The local media service (`apps/media`) and this Worker as that service reaches it.
    "MEDIA_URL": "http://127.0.0.1:8788",
    "API_ORIGIN": "http://127.0.0.1:8790"
    // C4, per environment: "WEB_ORIGINS" (the web app's origins, comma-separated; the mobile app's are always
    // allowed) and "MEDIA_INSTANCE_TYPE" (the Container instance type, e.g. "standard-4", which prices renders).
    // Dev needs neither: Vite serves the editor and the API from one origin, and the local media service is free.
  },
  "dev": { "port": 8790 }
}
