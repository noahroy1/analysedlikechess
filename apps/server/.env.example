# Copy to .env (gitignored). Keys never leave the server.
PORT=8787

# API keys (analysis is disabled until all three are set)
ANTHROPIC_API_KEY=        # console.anthropic.com
GEMINI_API_KEY=           # aistudio.google.com/apikey
ELEVENLABS_API_KEY=       # elevenlabs.io > Developers > API keys

# Models (defaults shown; chosen Oct 10, 2026)
TRANSCRIBER_MODEL=scribe_v2            # ElevenLabs Scribe v2: word timestamps, diarization, sound tags
SCENE_MODEL=gemini-3.5-flash-lite      # or gemini-3.8-flash for richer scene notes
NAMING_MODEL=claude-haiku-5-5          # the cheap speaker-naming call
ANALYST_MODEL=claude-opus-5-5          # Pass A and full Pass B
REGEN_MODEL=claude-sonnet-5-5          # single-moment Regenerate, faster

# Behaviour
AUTO_ANALYZE=true                      # analyse new clips as soon as ingest finishes
SCENE_FPS=1                            # frames per second Gemini samples
# ANALYSIS_REPLAY_DIR=../../fixtures/dialogue/recorded   # replay recorded responses, no API calls
# ANALYSIS_RECORD_DIR=../../fixtures/dialogue/recorded   # record real responses (refresh fixtures)
