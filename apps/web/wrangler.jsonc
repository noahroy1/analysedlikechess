// The editor as static files on Workers (no Worker code), one per environment:
// `node apps/api/scripts/deploy.ts <env> web` builds it against that environment's API and
// Supabase, then deploys `als-web-<env>`. Local dev serves it with Vite instead.
{
  "$schema": "../api/node_modules/wrangler/config-schema.json",
  "name": "als-web",
  "compatibility_date": "2026-11-04",
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" },
  "env": {
    "staging": {},
    "production": {}
  }
}
